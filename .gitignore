# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg

# --- Environments ---
.venv/
venv/
env/
.python-version

# --- Testing / linting caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS ---
.DS_Store
Thumbs.db

# --- Editors ---
.vscode/
.idea/
*.swp

# --- ML artifacts (large / non-reproducible-by-git binaries) ---
*.pt
*.pth
*.ckpt
*.safetensors
checkpoints/
wandb/
mlruns/
*.log

# --- Data (raw/processed experiment outputs are regenerated, not versioned) ---
# Root results/ dir, and any experiments/<name>/results/ dir (these patterns
# anchor at the directory containing this .gitignore for the root case, and
# gitignore's "**/" prefix matches at any depth for the experiment-level case
# -- both are needed since a mid-string slash without "**/" only matches the
# repo-root path).
results/raw/*
!results/raw/.gitkeep
results/processed/*
!results/processed/.gitkeep
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
**/results/raw/*
!**/results/raw/.gitkeep
**/results/processed/*
!**/results/processed/.gitkeep
**/results/figures/*
!**/results/figures/.gitkeep
**/results/tables/*
!**/results/tables/.gitkeep

# Local secrets / environment overrides
.env
.env.*

# --- Nano-transformer experiment: raw downloads / cached token streams ---
# (regenerated by experiments/nano_transformer/data.py; not versioned --
# results/raw and results/processed are covered by the patterns above)
experiments/nano_transformer/cache/
